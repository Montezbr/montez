{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.limit
-%}
<div class="section{% if section.settings.surface %} section--surface{% endif %}" style="--section-pt: {{ section.settings.pt }}px; --section-pb: {{ section.settings.pb }}px">
  <div class="page-width" {% if settings.animations %}data-reveal{% endif %}>
    <div class="section-header">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    {%- if section.settings.layout == 'carousel' -%}
      <div class="carousel" data-carousel>
        <ul class="carousel__track" role="list" style="--per-row: {{ section.settings.per_row }}; --per-row-mobile: 1.6" data-carousel-track>
          {%- if collection != blank and collection.products_count > 0 -%}
            {%- for product in collection.products limit: limit -%}
              <li>{% render 'product-card', product_card_product: product %}</li>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <li>{% render 'product-card-placeholder' %}</li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
        <button type="button" class="carousel__nav carousel__nav--prev" data-carousel-prev aria-label="Anterior">{% render 'icon', name: 'arrow-left' %}</button>
        <button type="button" class="carousel__nav carousel__nav--next" data-carousel-next aria-label="Próximo">{% render 'icon', name: 'arrow-right' %}</button>
      </div>
    {%- else -%}
      <ul class="product-grid" role="list" style="--per-row: {{ section.settings.per_row }}">
        {%- if collection != blank and collection.products_count > 0 -%}
          {%- for product in collection.products limit: limit -%}
            <li>{% render 'product-card', product_card_product: product %}</li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <li>{% render 'product-card-placeholder' %}</li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.show_view_all and collection != blank -%}
      <div style="text-align:center;margin-top:2rem">
        <a href="{{ collection.url }}" class="button button--primary">Ver todos</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Coleção em destaque",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Mais vendidos" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Os favoritos dos nossos clientes." },
    { "type": "collection", "id": "collection", "label": "Coleção" },
    { "type": "range", "id": "limit", "label": "Quantidade de produtos", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "select", "id": "layout", "label": "Formato", "default": "carousel", "options": [ { "value": "carousel", "label": "Carrossel" }, { "value": "grid", "label": "Grade" } ] },
    { "type": "range", "id": "per_row", "label": "Por linha (desktop)", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar botão \"Ver todos\"", "default": false },
    { "type": "checkbox", "id": "surface", "label": "Fundo colorido", "default": false },
    { "type": "range", "id": "pt", "label": "Espaço acima", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pb", "label": "Espaço abaixo", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [ { "name": "Coleção em destaque" } ]
}
{% endschema %}
