<div class="section{% if section.settings.surface %} section--surface{% endif %}" style="--section-pt: {{ section.settings.pt }}px; --section-pb: {{ section.settings.pb }}px">
  <div class="page-width image-text{% if section.settings.layout == 'right' %} image-text--reverse{% endif %}" {% if settings.animations %}data-reveal{% endif %}>
    <div class="image-text__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1400', sizes: '(min-width: 750px) 50vw, 100vw' }}
      {%- else -%}
        <div style="aspect-ratio:4/3;border-radius:var(--radius-card);overflow:hidden">{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      {%- endif -%}
    </div>
    <div>
      {%- if section.settings.heading != blank -%}<h2 class="text-primary">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte text-muted">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button" style="margin-top:1rem">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Imagem com texto",
  "tag": "section",
  "class": "section-image-text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem" },
    { "type": "select", "id": "layout", "label": "Posição da imagem", "default": "left", "options": [ { "value": "left", "label": "Esquerda" }, { "value": "right", "label": "Direita" } ] },
    { "type": "text", "id": "heading", "label": "Título", "default": "Conte a sua história" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Use esta seção para explicar o diferencial do produto ou da marca.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto do botão" },
    { "type": "url", "id": "button_link", "label": "Link do botão" },
    { "type": "checkbox", "id": "surface", "label": "Fundo colorido", "default": false },
    { "type": "range", "id": "pt", "label": "Espaço acima", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pb", "label": "Espaço abaixo", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [ { "name": "Imagem com texto" } ]
}
{% endschema %}
