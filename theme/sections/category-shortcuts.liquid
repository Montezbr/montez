<div class="section page-width" style="--section-pt: {{ section.settings.pt }}px; --section-pb: {{ section.settings.pb }}px">
  {%- if section.settings.heading != blank -%}
    <div class="section-header"><h2>{{ section.settings.heading }}</h2></div>
  {%- endif -%}
  <div class="carousel">
    <ul class="carousel__track categories__track" role="list" style="--cats: {{ section.blocks.size | at_most: section.settings.per_row }}" data-carousel-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign url = block.settings.link | default: block.settings.collection.url
          assign label = block.settings.label | default: block.settings.collection.title
          assign image = block.settings.image | default: block.settings.collection.featured_image
        -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ url | default: '#' }}" class="category-tile">
            <span class="category-tile__media" style="--tile-bg: {{ block.settings.bg }}">
              {%- if image != blank -%}
                {{ image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', sizes: '160px', alt: label }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="category-tile__label">{{ label | default: 'Categoria' }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Atalhos de categoria",
  "tag": "section",
  "class": "section-categories",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "range", "id": "per_row", "label": "Por linha (desktop)", "min": 3, "max": 9, "step": 1, "default": 7 },
    { "type": "range", "id": "pt", "label": "Espaço acima", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 12 },
    { "type": "range", "id": "pb", "label": "Espaço abaixo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção" },
        { "type": "image_picker", "id": "image", "label": "Imagem (vazio = imagem da coleção)", "info": "Prefira PNG com fundo transparente" },
        { "type": "text", "id": "label", "label": "Nome (vazio = nome da coleção)" },
        { "type": "url", "id": "link", "label": "Link (vazio = coleção)" },
        { "type": "color", "id": "bg", "label": "Fundo do card", "default": "#DDF1F3" }
      ]
    }
  ],
  "presets": [
    { "name": "Atalhos de categoria", "blocks": [ { "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" } ] }
  ]
}
{% endschema %}
