<div class="section{% if section.settings.full_width == false %} page-width{% endif %}" style="--section-pt: {{ section.settings.pt }}px; --section-pb: {{ section.settings.pb }}px">
  <div class="hero" data-slideshow data-autoplay="{% if section.settings.autoplay %}{{ section.settings.speed }}{% else %}0{% endif %}">
    <div class="hero__slides" data-slides {% unless section.settings.full_width == false %}style="border-radius:0"{% endunless %}>
      {%- for block in section.blocks -%}
        {%- liquid
          assign tag = 'div'
          if block.settings.link != blank and block.settings.button_label == blank
            assign tag = 'a'
          endif
          assign loading = 'lazy'
          if forloop.first
            assign loading = 'eager'
          endif
        -%}
        <{{ tag }} class="hero__slide" {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %} style="--slide-text: {{ block.settings.text_color }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image_mobile != blank -%}
            {{ block.settings.image_mobile | image_url: width: 900 | image_tag:
              class: 'hero__media-mobile', loading: loading, widths: '450, 750, 900', sizes: '100vw',
              alt: block.settings.image_mobile.alt | default: block.settings.heading
            }}
          {%- endif -%}
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 2400 | image_tag:
              class: 'hero__media-desktop', loading: loading, fetchpriority: 'high', widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw',
              alt: block.settings.image.alt | default: block.settings.heading
            }}
          {%- else -%}
            <div class="hero__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endif -%}

          {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank -%}
            <div class="hero__content{% if block.settings.align == 'center' %} hero__content--center{% endif %}">
              {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading }}</h2>{%- endif -%}
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <div><a href="{{ block.settings.link | default: '#' }}" class="button">{{ block.settings.button_label }}</a></div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </{{ tag }}>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 1 -%}
      <div class="hero__dots">
        {%- for block in section.blocks -%}
          <button type="button" class="hero__dot{% if forloop.first %} is-active{% endif %}" data-slide-dot aria-label="Ir para o slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Banner principal",
  "tag": "section",
  "class": "section-slideshow",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "full_width", "label": "Largura total", "default": false },
    { "type": "checkbox", "id": "autoplay", "label": "Trocar automaticamente", "default": true },
    { "type": "range", "id": "speed", "label": "Trocar a cada", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "range", "id": "pt", "label": "Espaço acima", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "pb", "label": "Espaço abaixo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 16 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem (desktop)", "info": "Recomendado: 2400 x 900 px" },
        { "type": "image_picker", "id": "image_mobile", "label": "Imagem (celular)", "info": "Recomendado: 900 x 1100 px" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "paragraph", "content": "Os textos abaixo são opcionais. Se a arte já tem texto, deixe em branco." },
        { "type": "text", "id": "heading", "label": "Título" },
        { "type": "text", "id": "text", "label": "Subtítulo" },
        { "type": "text", "id": "button_label", "label": "Texto do botão" },
        { "type": "select", "id": "align", "label": "Alinhamento", "default": "left", "options": [ { "value": "left", "label": "Esquerda" }, { "value": "center", "label": "Centro" } ] },
        { "type": "color", "id": "text_color", "label": "Cor do texto", "default": "#143740" }
      ]
    }
  ],
  "presets": [
    { "name": "Banner principal", "blocks": [ { "type": "slide" }, { "type": "slide" } ] }
  ]
}
{% endschema %}
