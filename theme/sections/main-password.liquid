<div class="section page-width empty-state" style="min-height:80vh;display:grid;place-content:center">
  <p class="header__logo-text">{{ shop.name }}</p>
  <h1 class="h2">{{ section.settings.heading }}</h1>
  {%- if shop.password_message != blank -%}<p class="text-muted">{{ shop.password_message }}</p>{%- endif -%}

  {%- form 'customer', class: 'newsletter-form', style: 'margin: 1.5rem auto' -%}
    <input type="hidden" name="contact[tags]" value="prospect,password page">
    <input type="email" name="contact[email]" placeholder="Seu e-mail" required aria-label="E-mail" style="border:1.5px solid var(--color-border)">
    <button type="submit" class="button button--small">Avise-me</button>
  {%- endform -%}

  <details style="margin-top:2rem">
    <summary class="text-muted" style="cursor:pointer">Entrar com senha</summary>
    {%- form 'storefront_password', class: 'newsletter-form', style: 'margin: 1rem auto' -%}
      <input type="password" name="password" placeholder="Senha" aria-label="Senha" style="border:1.5px solid var(--color-border)">
      <button type="submit" class="button button--small">Entrar</button>
      {%- if form.errors -%}<p class="form-message" style="width:100%">Senha incorreta.</p>{%- endif -%}
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Página de senha",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Em breve" }
  ]
}
{% endschema %}
