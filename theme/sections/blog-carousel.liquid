{%- assign blog = section.settings.blog -%}
<div class="section blog-carousel" style="--section-pt: {{ section.settings.pt }}px; --section-pb: {{ section.settings.pb }}px">
  <div class="page-width" {% if settings.animations %}data-reveal{% endif %}>
    <div class="section-header">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="carousel" data-carousel>
      <ul class="carousel__track" role="list" data-carousel-track>
        {%- if blog != blank and blog.articles_count > 0 -%}
          {%- for article in blog.articles limit: section.settings.limit -%}
            <li>
              <a href="{{ article.url }}" class="blog-card">
                <div class="blog-card__media">
                  {%- if article.image -%}
                    {{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 20vw, 90vw', alt: article.title }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="blog-card__content">
                  <span class="blog-card__date">{{ article.published_at | date: '%d %b' }}</span>
                  <h3 class="blog-card__title">{{ article.title }}</h3>
                  <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
                  <span class="link-arrow">Quero ler {% render 'icon', name: 'long-arrow' %}</span>
                </div>
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..2) -%}
            <li>
              <div class="blog-card">
                <div class="blog-card__media">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                <div class="blog-card__content">
                  <span class="blog-card__date">01 jan</span>
                  <h3 class="blog-card__title">Título do post do blog</h3>
                  <p class="blog-card__excerpt">Escolha um blog nas configurações da seção para mostrar os posts aqui.</p>
                </div>
              </div>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
      <button type="button" class="carousel__nav carousel__nav--prev" data-carousel-prev aria-label="Anterior">{% render 'icon', name: 'arrow-left' %}</button>
      <button type="button" class="carousel__nav carousel__nav--next" data-carousel-next aria-label="Próximo">{% render 'icon', name: 'arrow-right' %}</button>
    </div>
    {%- if blog != blank and section.settings.show_view_all -%}
      <div style="text-align:center;margin-top:1.5rem"><a href="{{ blog.url }}" class="button button--small">Ver tudo</a></div>
    {%- endif -%}
  </div>
</div>
<style>.link-arrow svg { width: 1rem; height: 1rem; }</style>

{% schema %}
{
  "name": "Posts do blog",
  "tag": "section",
  "class": "section-blog",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Conteúdos para você" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "limit", "label": "Quantidade de posts", "min": 2, "max": 10, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar botão \"Ver tudo\"", "default": true },
    { "type": "range", "id": "pt", "label": "Espaço acima", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pb", "label": "Espaço abaixo", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [ { "name": "Posts do blog" } ]
}
{% endschema %}
