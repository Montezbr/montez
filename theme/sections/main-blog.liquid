{%- paginate blog.articles by 12 -%}
  <div class="section page-width" style="--section-pt: 32px; --section-pb: 48px">
    <div class="collection-hero"><h1>{{ blog.title }}</h1></div>
    <ul class="product-grid" role="list" style="--per-row: 2">
      {%- for article in blog.articles -%}
        <li>
          <a href="{{ article.url }}" class="blog-card">
            <div class="blog-card__media">
              {%- if article.image -%}
                {{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 750px) 25vw, 100vw', alt: article.title }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="blog-card__content">
              <span class="blog-card__date">{{ article.published_at | date: '%d/%m/%Y' }}</span>
              <h2 class="blog-card__title">{{ article.title }}</h2>
              <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Paginação">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog", "tag": "section", "settings": [] }
{% endschema %}
