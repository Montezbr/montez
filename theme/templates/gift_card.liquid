{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Vale-presente {{ shop.name }}</title>
    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="section page-width empty-state">
      <p class="header__logo-text">{{ shop.name }}</p>
      <h1 class="h2">Seu vale-presente de {{ gift_card.initial_value | money }}</h1>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="text-muted">Este vale-presente não está mais ativo.</p>
      {%- endif -%}
      <p>Código</p>
      <p class="h3" style="letter-spacing:.1em">{{ gift_card.code | format_code }}</p>
      <p class="text-muted">Saldo: {{ gift_card.balance | money }}{% if gift_card.expires_on %} · válido até {{ gift_card.expires_on | date: '%d/%m/%Y' }}{% endif %}</p>
      <p><a href="{{ shop.url }}" class="button">Usar na loja</a></p>
      {%- if gift_card.pass_url -%}
        <p><a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Adicionar à Apple Wallet" loading="lazy"></a></p>
      {%- endif -%}
    </main>
  </body>
</html>
